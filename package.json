{
  "name": "perufindocs",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source document intelligence agent for Peruvian financial regulation, central-bank publications, and public-company disclosures.",
  "license": "MIT",
  "author": "Javier Pachas",
  "repository": {
    "type": "git",
    "url": "https://github.com/JavierPachas/perufindocs.git"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "eval": "python -m packages.evals.runner"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}

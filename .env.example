# =============================================================================
# PeruFinDocs — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-side only, never expose client-side

# ---- Upstash Redis (rate limiting + cache) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- LLM providers ----
# At least one is required to run the agent.
# Eval harness skips providers with missing keys (doesn't fail).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=             # for open-source models (Llama, Qwen)
GROQ_API_KEY=                 # optional, fast open-source inference

# ---- Embeddings & reranker ----
# If using a managed embeddings provider:
VOYAGE_API_KEY=               # optional, alternative to self-hosted
JINA_API_KEY=                 # optional
# If self-hosting via Modal:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---- App config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Ingestion (Python workers) ----
# Used by packages/ingestion only.
INGESTION_USER_AGENT=PeruFinDocs/0.1 (+https://github.com/JavierPachas/perufindocs)
INGESTION_REQUEST_DELAY_MS=2000   # respect source servers
